# ── Supabase (required) ────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Server-side only — NEVER expose in browser or commit to git ────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Vercel Cron auth ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Add the same value in Vercel → Settings → Environment Variables
CRON_SECRET=your-random-secret-min-32-chars

# ── Email reminders (optional) ─────────────────────────────────────────────────
# Sign up at resend.com — free tier: 3000 emails/month
# Verify your domain (cashmyrent.com) in Resend before use
RESEND_API_KEY=re_your_resend_api_key
